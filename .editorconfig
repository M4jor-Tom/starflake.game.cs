root = true

# SonarAnalyzer.CSharp runs in every build and TreatWarningsAsErrors makes its
# findings fail it. Size and complexity limits are at the analyzer's defaults:
# a method of at most 80 lines, a file of at most 1000 lines (which also caps a
# class: the analyzer has no class-length rule), cognitive complexity of at
# most 15.
[*.cs]
dotnet_diagnostic.S138.severity = warning
dotnet_diagnostic.S104.severity = warning
dotnet_diagnostic.S3776.severity = warning

# System.Random is fine here: spawn positions and scenery are not secrets.
dotnet_diagnostic.S2245.severity = none

# Generated by tools/sync-ontology.sh: its quality is the generator's.
[Domain/Generated/*.cs]
generated_code = true

# Generated by tools/sync-design.sh: its quality is the generator's.
[Design/Generated/*.cs]
generated_code = true
